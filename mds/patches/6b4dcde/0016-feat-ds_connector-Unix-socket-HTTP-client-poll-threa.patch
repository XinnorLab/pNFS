+/* -----------------------------------------------------------------------
+ * I/O half: a fake connector on a Unix socket
+ * ----------------------------------------------------------------------- */
+
+#include <unistd.h>
+#include <pthread.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <time.h>
